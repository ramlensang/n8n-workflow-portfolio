    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let raw = (item.json.output || '').trim();\n  const fenceMatch = raw.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/);\n  if (fenceMatch) raw = fenceMatch[1].trim();\n  try {\n    const parsed = JSON.parse(raw);\n    const arr = Array.isArray(parsed) ? parsed : [parsed];\n    arr.forEach((entry, i) => results.push({ json: entry, pairedItem: { item: 0 } }));\n  } catch (_) {}\n}\n\nreturn results.length > 0 ? results : [{ json: { _empty: true } }];"
      },
      "id": "98fe18fc-4ec9-42c8-8b2c-b0f6a727fb3a",
      "name": "Code: Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
