    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst today = DateTime.now().toFormat('yyyy-MM-dd');\n\nreturn items.map((item, idx) => {\n  const d = item.json;\n  const slug = (d.title || 'untitled')\n    .toLowerCase().replace(/[^a-z0-9\\s-]/g, '').trim()\n    .replace(/\\s+/g, '-').substring(0, 80);\n  const filename = `${today}-${slug}.md`;\n  const domains = Array.isArray(d.domain) ? d.domain.join(', ') : (d.domain || '');\n  const tags    = Array.isArray(d.tags)   ? d.tags.join(', ')   : (d.tags || '');\n  const keyClaims = (Array.isArray(d.key_claims) ? d.key_claims : []).map(c => `- ${c}`).join('\\n');\n  const entities  = (Array.isArray(d.entities)   ? d.entities  : []).map(e => `[[${e}]]`).join(', ');\n  const concepts  = (Array.isArray(d.concepts)   ? d.concepts  : []).map(c => `[[${c}]]`).join(', ');\n  const evergreen = d.evergreen === true ? 'true' : 'false';\n\n  const content = `---\\ntitle: \"${d.title}\"\\ntype: source\\ndomain: [${domains}]\\ntags: [${tags}]\\ncreated: ${today}\\nupdated: ${today}\\nsource_type: article\\nevergreen: ${evergreen}\\n---\\n\\n## Summary\\n${d.summary}\\n\\n## Key Claims\\n${keyClaims}\\n\\n## Key Entities\\n${entities}\\n\\n## Key Concepts\\n${concepts}\\n\\n## Gaps / Open Questions\\n${d.open_questions}`;\n\n  return { json: { filename, content }, pairedItem: { item: idx } };\n});"
      },
