    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Analyze these automotive technology search results and return the structured JSON array as instructed:\\n\\n' + JSON.stringify($json.results, null, 2) }}",
        "options": {
          "systemMessage": "You are an automotive technology research analyst. You receive a list of search results and must return a JSON array. Each item must have exactly these fields:\n- title: string\n- domain: array, values from [sdv, adas, emobility, auto-semi]\n- tags: array of 3-5 lowercase keyword strings\n- summary: 3-4 sentence technical summary\n- key_claims: array of 4-6 bullet strings\n- entities: array of named companies, platforms, or standards bodies mentioned\n- concepts: array of technical concepts or architectures mentioned\n- open_questions: string, one paragraph on what this source leaves unanswered\n- evergreen: boolean, true if the insight is durable beyond 3 months\n\nReturn only a JSON array. No preamble, no markdown fences."
        }
      },
