      "id": "7adf1523-bfc4-444d-9099-c65f593be0cd",
      "name": "Merge: All Search Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        224,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const d = item.json;\n  const blocks = d.text_blocks || [];\n  const refs = d.references || [];\n\n  // Extract from text_blocks\n  for (const b of blocks) {\n    const snippet = b.snippet || b.text || b.body || '';\n    const title = b.title || b.heading || '';\n    const url = b.link || b.url || '';\n    if (!snippet && !title) continue;\n    results.push({\n      title,\n      url,\n      snippet,\n      source: url ? (() => { try { return new URL(url).hostname; } catch(_) { return ''; } })() : '',\n      date: b.date || ''\n    });\n  }\n\n  // Extract from references\n  for (const r of refs) {\n    const url = r.link || r.url || '';\n    const title = r.title || r.heading || '';\n    const snippet = r.snippet || r.text || r.body || '';\n    if (!url && !title) continue;\n    results.push({\n      title,\n      url,\n      snippet,\n      source: url ? (() => { try { return new URL(url).hostname; } catch(_) { return ''; } })() : '',\n      date: r.date || ''\n    });\n  }\n}\n\nconst seen = new Set();\nconst deduped = results.filter(r => {\n  const key = r.url || r.title;\n  if (!key || seen.has(key)) return false;\n  seen.add(key);\n  return true;\n});\n\nreturn [{ json: { results: deduped, count: deduped.length } }];"
      },
      "id": "b1c8d2dd-0b51-4fd7-a069-aeccd5588b81",
      "name": "Code: Normalize Results",
