          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "f1111111-1111-1111-1111-111111111111",
              "leftValue": "={{ $json.title }}",
              "rightValue": "",
              "operator": {
