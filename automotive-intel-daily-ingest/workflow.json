        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "f2309868-6157-4fa8-9cb8-3607944ae69a",
      "name": "Filter: Required Fields",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        1248,
